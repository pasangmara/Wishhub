# ── Database ─────────────────────────────────────────────
# Any PostgreSQL 14+ (local, Supabase, Neon, RDS…)
DATABASE_URL=postgres://argus:argus@localhost:5432/argus_dev
# Set to "false" when connecting through a transaction pooler (Supabase :6543 / PgBouncer)
DATABASE_PREPARE=true

# ── App ──────────────────────────────────────────────────
# Public base URL used for review links, QR codes and share messages
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Long random string (openssl rand -base64 48). Signs admin sessions + photo tokens.
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_CONTACT_EMAIL=hello@argusofficial.com

# ── Seed / first admin (used only by `npm run db:seed` and `npm run admin:create`) ──
ADMIN_EMAIL=owner@abc-restaurant.test
ADMIN_PASSWORD=
ADMIN_NAME=Restaurant Owner

# ── Photo storage ────────────────────────────────────────
# local = ./uploads on disk (development / single server)
# s3    = any S3-compatible bucket (Supabase Storage S3, Cloudflare R2, AWS S3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Automation (optional) ────────────────────────────────
# Fallback n8n webhook for businesses without their own integration configured
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── Abuse protection ─────────────────────────────────────
# Max reviews per hour from one (hashed) IP address, per business
REVIEW_RATE_LIMIT_PER_HOUR=8
